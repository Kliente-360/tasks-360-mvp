# Copie pra .env.local (dev) e configure as mesmas chaves no painel
# do site Netlify NOVO (Site settings > Environment variables).

# Supabase — mesmo projeto do app atual. A anon key é pública (a RLS
# protege); pode ser commitada se preferir, mas env var é mais limpo.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Conexão direta do Postgres pro Drizzle (server-side apenas, NUNCA
# expor no client). Pega em Supabase > Project Settings > Database >
# Connection string > "Transaction pooler" (porta 6543) ou direta.
# Ex: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://...
